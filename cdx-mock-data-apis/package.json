{
  "name": "cdx-mock-data-apis",
  "version": "0.1.0",
  "description": "Lightweight mock API server for Candescent extension development — provides realistic financial data for widget and aspect templates",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm",
    "test": "tsx --test src/smoke.test.ts"
  },
  "keywords": [
    "mock",
    "api",
    "candescent",
    "extensions",
    "widgets",
    "hono"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/candescent-dev/cdx-mock.git",
    "directory": "cdx-mock-data-apis"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.14"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
